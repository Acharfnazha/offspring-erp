# PostgreSQL connection string
DATABASE_URL="postgresql://offspring:offspring@localhost:5432/offspring_erp?schema=public"
# Separate database used by integration tests (will be migrated & truncated)
TEST_DATABASE_URL="postgresql://offspring:offspring@localhost:5432/offspring_erp_test?schema=public"
# Public base URL of the app (used in password-reset links)
APP_URL="http://localhost:3000"
# Set to "true" behind HTTPS so session cookies are marked Secure
COOKIE_SECURE="false"
# Directory for uploaded documents (outside the web root)
UPLOAD_DIR="./storage/uploads"
# Max upload size in megabytes
MAX_UPLOAD_MB="10"
# Business time zone used for date boundaries (storage billing, reports)
BUSINESS_TIMEZONE="Asia/Beirut"
# Optional AI provider. Leave empty to run the assistant in offline demo mode.
AI_PROVIDER=""            # "anthropic" or empty
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
