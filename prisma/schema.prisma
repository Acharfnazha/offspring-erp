// OFFSPRING ERP — PostgreSQL schema
// Money is always Decimal(18,2); unit prices/rates Decimal(18,4); weights Decimal(14,3) kg.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & security ─────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  WAREHOUSE_MANAGER
  SALES_MANAGER
  LOGISTICS_MANAGER
  EMPLOYEE
  VIEWER
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  role               Role                 @default(EMPLOYEE)
  jobTitle           String?
  phone              String?
  active             Boolean              @default(true)
  locale             String               @default("en")
  lastLoginAt        DateTime?
  failedLogins       Int                  @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  documents          Document[]
  movements          InventoryMovement[]
  profitCalculations ProfitCalculation[]
  readings           ColdRoomReading[]
  approvedExpenses   Expense[]            @relation("ExpenseApprover")
  createdExpenses    Expense[]            @relation("ExpenseCreator")
  rolePermissions    RolePermission[]     @relation("GrantedBy")
}

/// Permission catalogue (seeded from src/lib/auth/permissions.ts, which is the runtime source of truth).
model Permission {
  key         String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  role          Role
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  grantedById   String?
  grantedBy     User?      @relation("GrantedBy", fields: [grantedById], references: [id])

  @@id([role, permissionKey])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  summary   String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When userId is null the notification targets every user holding `audienceRole` (or all users if null)
  audienceRole Role?
  type      String
  severity  String    @default("info")
  title     String
  body      String?
  link      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ───────────────────────────── Master data ─────────────────────────────

enum CustomerType {
  IMPORTER
  WHOLESALER
  SUPERMARKET
  DISTRIBUTOR
  EXPORT_PARTNER
  COLD_STORAGE_CUSTOMER
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  NEGOTIATION
  QUOTATION_SENT
  ORDER_CONFIRMED
  SHIPMENT_PREPARATION
  SHIPPED
  DELIVERED
  PAID
  CLOSED
}

model Customer {
  id               String            @id @default(cuid())
  code             String            @unique
  companyName      String
  country          String
  city             String?
  address          String?
  contactPerson    String?
  email            String?
  whatsapp         String?
  phone            String?
  website          String?
  currency         String            @default("USD")
  paymentTermsDays Int               @default(30)
  paymentTerms     String?
  type             CustomerType      @default(IMPORTER)
  creditLimit      Decimal           @default(0) @db.Decimal(18, 2)
  pipelineStage    PipelineStage     @default(NEW_LEAD)
  nextFollowUpAt   DateTime?
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quotations       Quotation[]
  orders           SalesOrder[]
  invoices         Invoice[]
  payments         Payment[]
  shipments        Shipment[]
  storageContracts StorageContract[]
  documents        Document[]

  @@index([companyName])
  @@index([country])
}

model Supplier {
  id               String          @id @default(cuid())
  code             String          @unique
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  whatsapp         String?
  country          String          @default("Lebanon")
  city             String?
  address          String?
  productsSupplied String?
  pricingNotes     String?
  qualityNotes     String?
  qualityRating    Int?
  paymentTermsDays Int             @default(30)
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  batches          InventoryBatch[]
  purchaseOrders   PurchaseOrder[]
  receipts         GoodsReceipt[]
  invoices         Invoice[]
  payments         Payment[]
  documents        Document[]

  @@index([name])
}

enum FruitCategory {
  APPLE
  GRAPE
  PEACH
  NECTARINE
  OTHER
}

model Product {
  id        String           @id @default(cuid())
  name      String           @unique
  category  FruitCategory
  createdAt DateTime         @default(now())
  varieties ProductVariety[]
}

model ProductVariety {
  id               String             @id @default(cuid())
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  name             String
  shelfLifeDays    Int                @default(90)
  referenceCostKg  Decimal?           @db.Decimal(18, 4)
  active           Boolean            @default(true)
  batches          InventoryBatch[]
  orderItems       OrderItem[]
  quotationItems   QuotationItem[]
  poItems          PurchaseOrderItem[]
  storageContracts StorageContract[]

  @@unique([productId, name])
}

// ───────────────────────────── Warehousing ─────────────────────────────

model Warehouse {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  location  String?
  createdAt DateTime   @default(now())
  coldRooms ColdRoom[]
}

enum ColdRoomStatus {
  OPERATIONAL
  MAINTENANCE
  OFFLINE
}

model ColdRoom {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  capacityKg       Decimal           @db.Decimal(14, 3)
  targetTempC      Decimal           @db.Decimal(5, 2)
  targetHumidity   Decimal           @db.Decimal(5, 2)
  tempToleranceC   Decimal           @default(1.5) @db.Decimal(5, 2)
  currentTempC     Decimal?          @db.Decimal(5, 2)
  currentHumidity  Decimal?          @db.Decimal(5, 2)
  lastReadingAt    DateTime?
  status           ColdRoomStatus    @default(OPERATIONAL)
  maintenanceNotes String?
  /// Identifier of an external IoT sensor (future integration)
  sensorId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  batches          InventoryBatch[]
  readings         ColdRoomReading[]
  storageContracts StorageContract[]
}

model ColdRoomReading {
  id           String   @id @default(cuid())
  coldRoomId   String
  coldRoom     ColdRoom @relation(fields: [coldRoomId], references: [id], onDelete: Cascade)
  temperatureC Decimal  @db.Decimal(5, 2)
  humidity     Decimal? @db.Decimal(5, 2)
  source       String   @default("MANUAL")
  outOfRange   Boolean  @default(false)
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())

  @@index([coldRoomId, recordedAt])
}

// ───────────────────────────── Inventory ─────────────────────────────

enum Grade {
  EXTRA
  CLASS_I
  CLASS_II
  CUSTOM
}

enum BatchStatus {
  AVAILABLE
  RESERVED
  DEPLETED
  QUARANTINE
  SPOILED
}

model InventoryBatch {
  id              String                 @id @default(cuid())
  batchNo         String                 @unique
  varietyId       String
  variety         ProductVariety         @relation(fields: [varietyId], references: [id])
  grade           Grade                  @default(CLASS_I)
  customGrade     String?
  origin          String                 @default("Lebanon")
  supplierId      String?
  supplier        Supplier?              @relation(fields: [supplierId], references: [id])
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt?          @relation(fields: [goodsReceiptId], references: [id])
  parentBatchId   String?
  parentBatch     InventoryBatch?        @relation("BatchSplit", fields: [parentBatchId], references: [id])
  childBatches    InventoryBatch[]       @relation("BatchSplit")
  harvestDate     DateTime?              @db.Date
  arrivalDate     DateTime               @db.Date
  expiryDate      DateTime?              @db.Date
  receivedKg      Decimal                @db.Decimal(14, 3)
  onHandKg        Decimal                @db.Decimal(14, 3)
  reservedKg      Decimal                @default(0) @db.Decimal(14, 3)
  cartons         Int                    @default(0)
  packagingType   String?
  costPerKg       Decimal                @db.Decimal(18, 4)
  coldRoomId      String?
  coldRoom        ColdRoom?              @relation(fields: [coldRoomId], references: [id])
  status          BatchStatus            @default(AVAILABLE)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  movements       InventoryMovement[]
  reservations    InventoryReservation[]
  documents       Document[]

  @@index([varietyId])
  @@index([coldRoomId])
  @@index([status])
  @@index([arrivalDate])
}

enum MovementType {
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVE
  RELEASE
  SPOILAGE
  DISPATCH
  ADJUSTMENT
}

/// Immutable ledger — UPDATE/DELETE are blocked by a database trigger.
model InventoryMovement {
  id              String         @id @default(cuid())
  batchId         String
  batch           InventoryBatch @relation(fields: [batchId], references: [id])
  type            MovementType
  quantityKg      Decimal        @db.Decimal(14, 3)
  onHandAfterKg   Decimal        @db.Decimal(14, 3)
  reservedAfterKg Decimal        @db.Decimal(14, 3)
  cartons         Int?
  reference       String?
  notes           String?
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([batchId, createdAt])
  @@index([type, createdAt])
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
}

model InventoryReservation {
  id          String            @id @default(cuid())
  batchId     String
  batch       InventoryBatch    @relation(fields: [batchId], references: [id])
  orderItemId String?
  orderItem   OrderItem?        @relation(fields: [orderItemId], references: [id])
  quantityKg  Decimal           @db.Decimal(14, 3)
  fulfilledKg Decimal           @default(0) @db.Decimal(14, 3)
  status      ReservationStatus @default(ACTIVE)
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([batchId, status])
  @@index([orderItemId])
}

// ───────────────────────────── Cold storage services ─────────────────────────────

enum ContractStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model StorageContract {
  id                 String              @id @default(cuid())
  contractNo         String              @unique
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  varietyId          String?
  variety            ProductVariety?     @relation(fields: [varietyId], references: [id])
  productDescription String
  batchReference     String?
  coldRoomId         String
  coldRoom           ColdRoom            @relation(fields: [coldRoomId], references: [id])
  ratePerKgMonth     Decimal             @default(0.05) @db.Decimal(18, 4)
  minimumPeriods     Int                 @default(1)
  entryDate          DateTime            @db.Date
  exitDate           DateTime?           @db.Date
  status             ContractStatus      @default(ACTIVE)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  movements          StorageMovement[]
  adjustments        StorageAdjustment[]
  invoices           Invoice[]
}

enum StorageMovementType {
  IN
  OUT
}

model StorageMovement {
  id         String              @id @default(cuid())
  contractId String
  contract   StorageContract     @relation(fields: [contractId], references: [id])
  type       StorageMovementType
  quantityKg Decimal             @db.Decimal(14, 3)
  date       DateTime            @db.Date
  notes      String?
  createdAt  DateTime            @default(now())

  @@index([contractId, date])
}

model StorageAdjustment {
  id         String          @id @default(cuid())
  contractId String
  contract   StorageContract @relation(fields: [contractId], references: [id])
  amount     Decimal         @db.Decimal(18, 2)
  reason     String
  createdById String?
  invoiceId  String?
  createdAt  DateTime        @default(now())
}

// ───────────────────────────── Purchasing ─────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNo         String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  currency     String              @default("USD")
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]
  invoices     Invoice[]
}

model PurchaseOrderItem {
  id          String         @id @default(cuid())
  poId        String
  po          PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  varietyId   String
  variety     ProductVariety @relation(fields: [varietyId], references: [id])
  grade       Grade          @default(CLASS_I)
  quantityKg  Decimal        @db.Decimal(14, 3)
  unitCostKg  Decimal        @db.Decimal(18, 4)
  receivedKg  Decimal        @default(0) @db.Decimal(14, 3)
}

model GoodsReceipt {
  id         String           @id @default(cuid())
  receiptNo  String           @unique
  poId       String?
  po         PurchaseOrder?   @relation(fields: [poId], references: [id])
  supplierId String
  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  receivedAt DateTime         @db.Date
  notes      String?
  createdById String?
  createdAt  DateTime         @default(now())
  batches    InventoryBatch[]
}

// ───────────────────────────── Sales ─────────────────────────────

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DDP
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id               String              @id @default(cuid())
  quoteNo          String              @unique
  revision         Int                 @default(1)
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  status           QuotationStatus     @default(DRAFT)
  issueDate        DateTime            @db.Date
  validUntil       DateTime            @db.Date
  currency         String              @default("USD")
  incoterm         Incoterm            @default(FOB)
  paymentTerms     String?
  deliveryTerms    String?
  portOfLoading    String?
  portOfDischarge  String?
  shipmentDetails  String?
  notes            String?
  subtotal         Decimal             @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal             @default(0) @db.Decimal(18, 2)
  total            Decimal             @default(0) @db.Decimal(18, 2)
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            QuotationItem[]
  revisions        QuotationRevision[]
  salesOrder       SalesOrder?
}

model QuotationItem {
  id          String          @id @default(cuid())
  quotationId String
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  varietyId   String?
  variety     ProductVariety? @relation(fields: [varietyId], references: [id])
  description String
  grade       Grade           @default(CLASS_I)
  origin      String          @default("Lebanon")
  packaging   String?
  quantityKg  Decimal         @db.Decimal(14, 3)
  unitPrice   Decimal         @db.Decimal(18, 4)
  discountPct Decimal         @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal         @db.Decimal(18, 2)
  sortOrder   Int             @default(0)
}

model QuotationRevision {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision    Int
  snapshot    Json
  reason      String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([quotationId, revision])
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id                   String        @id @default(cuid())
  orderNo              String        @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  quotationId          String?       @unique
  quotation            Quotation?    @relation(fields: [quotationId], references: [id])
  status               OrderStatus   @default(DRAFT)
  orderDate            DateTime      @db.Date
  currency             String        @default("USD")
  exchangeRate         Decimal       @default(1) @db.Decimal(18, 6)
  incoterm             Incoterm      @default(FOB)
  paymentTerms         String?
  deliveryTerms        String?
  expectedShipmentDate DateTime?     @db.Date
  subtotal             Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal        Decimal       @default(0) @db.Decimal(18, 2)
  total                Decimal       @default(0) @db.Decimal(18, 2)
  notes                String?
  overrideReason       String?
  overrideById         String?
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  items                OrderItem[]
  invoices             Invoice[]
  shipments            ShipmentOrder[]
  events               OrderEvent[]
}

model OrderItem {
  id           String                 @id @default(cuid())
  orderId      String
  order        SalesOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  varietyId    String
  variety      ProductVariety         @relation(fields: [varietyId], references: [id])
  grade        Grade                  @default(CLASS_I)
  description  String?
  packaging    String?
  quantityKg   Decimal                @db.Decimal(14, 3)
  unitPrice    Decimal                @db.Decimal(18, 4)
  discountPct  Decimal                @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal                @db.Decimal(18, 2)
  fulfilledKg  Decimal                @default(0) @db.Decimal(14, 3)
  /// Cost of goods dispatched (sum of batch cost × kg), used for gross profit
  cogsAmount   Decimal                @default(0) @db.Decimal(18, 2)
  reservations InventoryReservation[]
  shipmentItems ShipmentItem[]
}

model OrderEvent {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  note      String?
  userId    String?
  createdAt DateTime   @default(now())
}

// ───────────────────────────── Logistics ─────────────────────────────

enum ShipmentStatus {
  PLANNING
  PACKING
  READY_FOR_DISPATCH
  IN_TRANSIT
  ARRIVED
  DELIVERED
  COMPLETED
  CANCELLED
}

model Shipment {
  id                String          @id @default(cuid())
  shipmentNo        String          @unique
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  containerNo       String?
  containerType     String?
  transportMode     String          @default("SEA")
  shippingLine      String?
  freightForwarder  String?
  origin            String          @default("Lebanon")
  destination       String
  portOfLoading     String?
  portOfDischarge   String?
  etd               DateTime?       @db.Date
  atd               DateTime?       @db.Date
  eta               DateTime?       @db.Date
  ata               DateTime?       @db.Date
  grossWeightKg     Decimal?        @db.Decimal(14, 3)
  netWeightKg       Decimal?        @db.Decimal(14, 3)
  cartons           Int?
  freightCost       Decimal         @default(0) @db.Decimal(18, 2)
  insuranceCost     Decimal         @default(0) @db.Decimal(18, 2)
  documentationCost Decimal         @default(0) @db.Decimal(18, 2)
  customsCost       Decimal         @default(0) @db.Decimal(18, 2)
  status            ShipmentStatus  @default(PLANNING)
  trackingProvider  String?
  trackingRef       String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orders            ShipmentOrder[]
  items             ShipmentItem[]
  events            ShipmentEvent[]
  documents         Document[]
  invoices          Invoice[]
  expenses          Expense[]
}

model ShipmentOrder {
  shipmentId String
  shipment   Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderId    String
  order      SalesOrder @relation(fields: [orderId], references: [id])

  @@id([shipmentId, orderId])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantityKg  Decimal   @db.Decimal(14, 3)
  cartons     Int?
  createdAt   DateTime  @default(now())
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  location   String?
  occurredAt DateTime       @default(now())
  userId     String?
}

// ───────────────────────────── Finance ─────────────────────────────

enum InvoiceType {
  SALES
  PURCHASE
  COLD_STORAGE
  PRO_FORMA
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                String              @id @default(cuid())
  invoiceNo         String              @unique
  type              InvoiceType
  status            InvoiceStatus       @default(DRAFT)
  customerId        String?
  customer          Customer?           @relation(fields: [customerId], references: [id])
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  storageContractId String?
  storageContract   StorageContract?    @relation(fields: [storageContractId], references: [id])
  shipmentId        String?
  shipment          Shipment?           @relation(fields: [shipmentId], references: [id])
  originalInvoiceId String?
  originalInvoice   Invoice?            @relation("CreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes       Invoice[]           @relation("CreditNotes")
  issueDate         DateTime            @db.Date
  dueDate           DateTime            @db.Date
  currency          String              @default("USD")
  exchangeRate      Decimal             @default(1) @db.Decimal(18, 6)
  subtotal          Decimal             @default(0) @db.Decimal(18, 2)
  discountTotal     Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal             @default(0) @db.Decimal(18, 2)
  total             Decimal             @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal             @default(0) @db.Decimal(18, 2)
  billingPeriodEnd  DateTime?           @db.Date
  incoterm          Incoterm?
  notes             String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  items             InvoiceItem[]
  allocations       PaymentAllocation[]
  documents         Document[]

  @@index([status, dueDate])
  @@index([customerId])
  @@index([supplierId])
  @@index([type, issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String  @default("kg")
  unitPrice   Decimal @db.Decimal(18, 4)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  taxPct      Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0)
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

model Payment {
  id             String              @id @default(cuid())
  paymentNo      String              @unique
  direction      PaymentDirection
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  method         PaymentMethod
  amount         Decimal             @db.Decimal(18, 2)
  currency       String              @default("USD")
  paidAt         DateTime            @db.Date
  reference      String?
  /// Client-generated key that makes a submission idempotent (prevents double posting)
  idempotencyKey String              @unique
  notes          String?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime            @default(now())
  allocations    PaymentAllocation[]

  @@index([customerId])
  @@index([supplierId])
  @@index([paidAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
}

enum ExpenseCategory {
  FRUIT_PURCHASES
  PACKAGING
  TRANSPORTATION
  FUEL
  ELECTRICITY
  REFRIGERATION
  MAINTENANCE
  LABOR
  SALARIES
  CUSTOMS
  FREIGHT
  INSURANCE
  ADMINISTRATIVE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id           String          @id @default(cuid())
  expenseNo    String          @unique
  category     ExpenseCategory
  description  String
  vendor       String?
  amount       Decimal         @db.Decimal(18, 2)
  currency     String          @default("USD")
  date         DateTime        @db.Date
  status       ExpenseStatus   @default(PENDING)
  shipmentId   String?
  shipment     Shipment?       @relation(fields: [shipmentId], references: [id])
  approvedById String?
  approvedBy   User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdById  String?
  createdBy    User?           @relation("ExpenseCreator", fields: [createdById], references: [id])
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  documents    Document[]

  @@index([category, date])
}

model ProfitCalculation {
  id          String   @id @default(cuid())
  name        String
  inputs      Json
  outputs     Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ───────────────────────────── Documents ─────────────────────────────

enum DocumentAccess {
  ALL_STAFF
  FINANCE
  MANAGEMENT
}

model Document {
  id           String          @id @default(cuid())
  name         String
  category     String
  mimeType     String
  sizeBytes    Int
  storageKey   String          @unique
  sha256       String
  access       DocumentAccess  @default(ALL_STAFF)
  description  String?
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  supplierId   String?
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  shipmentId   String?
  shipment     Shipment?       @relation(fields: [shipmentId], references: [id])
  invoiceId    String?
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  expenseId    String?
  expense      Expense?        @relation(fields: [expenseId], references: [id])
  batchId      String?
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])
  uploadedById String?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id])
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([category])
  @@index([customerId])
  @@index([shipmentId])
}
